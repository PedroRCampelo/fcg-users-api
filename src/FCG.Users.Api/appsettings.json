{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ],
    "Properties": {
      "Application": "fcg-users-api"
    }
  },
  "Jwt": {
    "Issuer": "fcg-users-api",
    "Audience": "fcg",
    "ExpirationMinutes": 60
  },
  "RabbitMq": {
    "Host": "localhost",
    "Port": 5672,
    "VirtualHost": "/",
    "Queues": {
      "NotificationsUserCreated": "notifications.user-created"
    }
  },
  "AdminPadrao": {
    "Email": "admin@fcg.com",
    "Senha": "Admin123!"
  },
  "AllowedHosts": "*"
}
